# ####################################################################
# Node.js Standard .gitignore Template
# ####################################################################

# Dependencies
# Never commit the massive node_modules folder to version control
node_modules/
jspm_packages/
web_modules/

# Logs
# Keep debugging logs out of your repository
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Diagnostic reports (Crashed Node processes)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul or nyc
coverage
.nyc_output

# Next.js build output
.next/
out/

# Nuxt.js build output
.nuxt/
dist/

# Gatsby files
.cache/
public/

# vue-cli server build output
dist/

# Serverless Framework folders
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# TypeScript output
# Uncomment this if you compile TS to a separate directory (e.g., dist or build)
# dist/
# build/

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# TS command line cache
tsconfig.tsbuildinfo

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
# CRITICAL: Do not commit sensitive API keys or database credentials!
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundle cache
.cache
.parcel-cache

# Next.js telemetry cache
.next

# Nuxt.js dev/build outputs
.nuxt

# Serverless Webpack directories
.webpack/

# Bundler caches
.turbo
.nuxt
.next

# macOS system files
.DS_Store
Thumbs.db
